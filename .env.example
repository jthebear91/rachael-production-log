# Square — wholesale (Rachael's Seafood). New names preferred; legacy fallbacks still work.
SQUARE_WHOLESALE_TOKEN=
SQUARE_WHOLESALE_LOCATION_ID=
SQUARE_TOKEN=
SQUARE_LOCATION_ID=

# Square — Lafayette cafe
SQUARE_LAFAYETTE_TOKEN=
SQUARE_LAFAYETTE_LOCATION_ID=

# Square — Maurice cafe (SQUARE_RESTAURANT_* is a legacy alias)
SQUARE_MAURICE_TOKEN=
SQUARE_MAURICE_LOCATION_ID=
SQUARE_RESTAURANT_TOKEN=
SQUARE_RESTAURANT_LOCATION_ID=

# Read-only /api/square/* bridge (assistants). Fail closed if unset.
BRIDGE_API_KEY=
# Mint-only secret for POST /api/pick/maurice-restock/create. Claude's nightly
# job uses this and must not receive BRIDGE_API_KEY. Not accepted by Send,
# inventory, invoices, or other /api/square/* routes. Use a different value
# from BRIDGE_API_KEY. See docs/maurice-restock-pick-qr.md.
PICK_MINT_API_KEY=

# Shared PIN for /dashboard and sales totals. Daily production log stays public.
# Local `next dev` with this unset allows sales access. Production (VERCEL=1 or
# NODE_ENV=production) with this unset blocks sales and shows "PIN not configured".
SALES_DASHBOARD_PIN=

# Supabase (batch tracker + Maurice pick tokens). Service key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Maurice nightly pick QR. See docs/maurice-restock-pick-qr.md
# Origin encoded in the QR. Production defaults to the host below when unset.
APP_BASE_URL=https://rachael-production-log.vercel.app
# Maurice as a customer on the wholesale Square account (Rachaels Cafe Maurice).
# Used only when the unpaid invoice is turned on. Optional; code has a default.
SQUARE_MAURICE_CUSTOMER_ID=
# Inventory gate. Dry-run is the default: Send marks the pick sent and logs the
# adjustment, and does not call inventory.batchChange.
# Live deduct requires BOTH lines below, then a redeploy, and only after the
# Claude 2am prompt no longer deducts in step 7. See docs/maurice-restock-pick-qr.md.
MAURICE_PICK_SEND_DRY_RUN=1
MAURICE_PICK_LIVE_DEDUCT=0
# Daily Send never creates an invoice. MAURICE_PICK_CREATE_INVOICE is ignored.
# Monday rollup: POST /api/pick/maurice-restock/week-invoice
# One unpaid SHARE_MANUALLY invoice for the prior Mon-Sat of live sends.
# Optional http(s) URL for the post-pull final total and shorts. Not Twilio.
JORDAN_NOTIFY_WEBHOOK=

# Todoist
TODOIST_TOKEN=
TODOIST_COOK_PROJECT_ID=
# Takeout board for wholesale Square pull tasks. Not the Package board.
# Package 6cv69FHPW88HVjH8 stays packaging/production only.
TODOIST_TAKEOUT_PROJECT_ID=6cv69FrQF2QcqVqw

# Wholesale Square → Takeout pull task + pick-list PDF.
# Leave WHOLESALE_PULL_ENABLED empty until the webhook signature key,
# Takeout project id, and supabase/wholesale_pulls.sql are in place.
# See docs/wholesale-pull.md.
WHOLESALE_PULL_ENABLED=
# Webhook subscription signature key from the Square Developer Dashboard. Not the access token.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact notification URL registered on the Square webhook. Signature checks use this string.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://rachael-production-log.vercel.app/api/square/wholesale-pull/webhook
# Optional comma-separated tender-name substrings treated as a house account.
WHOLESALE_PULL_TENDER_NAMES=
# Set to 1 to also pull every COMPLETED sale at the wholesale location.
# Default is unpaid invoices plus EXTERNAL/OTHER house-account tenders only.
WHOLESALE_PULL_ALL_COMPLETED=
# Dev only. Ignored when NODE_ENV=production.
WHOLESALE_PULL_DEV_BYPASS=
# Not a Vercel variable. Set this only on the Trey laptop (hostname Trey-s-A25, user rachaelsseafood).
# Folder drop still works when it is unset: ~/Documents/Wholesale Ordering/pull-sheets/
# Recommended queue (exact): Brother_HL_L3280CDW_series (Brother HL-L3280CDW).
# Never point wholesale at the Mac mini Maurice cafe queue.
# WHOLESALE_PULL_PRINTER=Brother_HL_L3280CDW_series

# Wholesale text → unpaid Square invoices. Fail closed when unset in production.
# Grogu collects Twilio values via secure cards after the Google Voice port.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Dev only: signature bypass when NODE_ENV is not production. Never set this in production.
WHOLESALE_TEXT_DEV_BYPASS=
# Optional JSON array that replaces data/wholesale-text-allowlist.json without a redeploy.
WHOLESALE_TEXT_ALLOWLIST_JSON=
# Optional comma-separated crew phones for outbound SMS after a known-number text.
WHOLESALE_TEXT_NOTIFY_PHONES=
